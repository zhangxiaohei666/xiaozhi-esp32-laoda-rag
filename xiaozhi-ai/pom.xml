<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xiaozhi</groupId>
        <artifactId>xiaozhi-parent</artifactId>
        <version>6.1.0</version>
    </parent>
    <artifactId>xiaozhi-ai</artifactId>
    <name>xiaozhi-ai</name>
    <description>AI 能力平台：LLM/TTS/STT provider + 记忆管理</description>

    <dependencies>
        <dependency>
            <groupId>com.xiaozhi</groupId>
            <artifactId>xiaozhi-service</artifactId>
        </dependency>
        <!-- xiaozhi-common 通过 xiaozhi-service 传递 -->
        <!-- Spring AI -->
        <!-- ChatClient API（Spring AI 1.1 起从 spring-ai-model 拆出到独立 artifact） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-ollama</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-zhipuai</artifactId>
        </dependency>
        <!-- Qdrant 向量库（RAG；方案 §8。提供 QdrantVectorStore + QdrantClient 类）
             注意：必须用【非 starter】的核心模块。starter 会带进
             spring-ai-autoconfigure-vector-store-qdrant，它强制要求容器里有 EmbeddingModel bean；
             而本项目是按需从 sys_config 造模型（不用 Spring AI 自动配置），
             用 starter 会导致启动直接失败：Consider defining a bean of type 'EmbeddingModel' -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-qdrant-store</artifactId>
        </dependency>
        <!--
          Tika：文档解析 —— RAG 入库用（方案 §8.1）

          这里只引 tika-core（AutoDetectParser 本体）+ text-module（txt/md/csv）。
          不要再引 tika-parsers-standard-package：它会拖进 18 个 module、25MB+
          依赖（音频视频、CAD、邮件、OCR、POI、PDFBox 等），而本项目只解析 txt/md。

          将来要支持 PDF / Word，只在根 pom 的 dependencyManagement 里放开对应模块，
          再到此处加一行 artifactId 即可，DocumentIngestService 不用改。
        -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parser-text-module</artifactId>
        </dependency>
        <!-- gRPC API：io.qdrant:client 把 gRPC 全标成 runtime 作用域，
             编译期解析 QdrantGrpcClient.newBuilder(...) 需要 io.grpc.ManagedChannel 这个类型 -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
        </dependency>
        <!-- MCP Client -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>
        <!-- WebSocket (MCP Endpoint) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- JSON (Vosk STT) -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
        </dependency>
        <!-- OkHttp -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-sse</artifactId>
        </dependency>
        <dependency>
            <groupId>com.squareup.okio</groupId>
            <artifactId>okio</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-reflect</artifactId>
        </dependency>
        <!-- 音频处理 -->
        <dependency>
            <groupId>io.github.whitemagic2014</groupId>
            <artifactId>tts-edge-java</artifactId>
        </dependency>
        <!-- FunASRSttService/EdgeTtsService 直接用到，原来只靠讯飞SDK/tts-edge-java传递引入，显式声明避免版本失控 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alphacephei</groupId>
            <artifactId>vosk</artifactId>
        </dependency>
        <!-- 云服务 SDK -->
        <dependency>
            <groupId>com.tencentcloudapi</groupId>
            <artifactId>tencentcloud-speech-sdk-java</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.nls</groupId>
            <artifactId>nls-sdk-transcriber</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.nls</groupId>
            <artifactId>nls-sdk-tts</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>dashscope-sdk-java</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>aliyun-java-sdk-core</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.xfyun</groupId>
            <artifactId>websdk-java-speech</artifactId>
        </dependency>
        <dependency>
            <groupId>com.coze</groupId>
            <artifactId>coze-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.imfangs</groupId>
            <artifactId>dify-java-client</artifactId>
        </dependency>
        <!-- Sherpa-ONNX（从项目内仓库 repo/ 解析，版本由父 POM 统一管理） -->
        <dependency>
            <groupId>com.k2fsa</groupId>
            <artifactId>sherpa-onnx</artifactId>
        </dependency>
        <!-- Caffeine (EmbeddingService 短 TTL 缓存) -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
